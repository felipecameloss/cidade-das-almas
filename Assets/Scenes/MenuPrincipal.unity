  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Objetivo</b>\nColete todas as almas azuis antes que o tempo do ritual acabe. Cada alma d\xE1 +3 segundos.\n\n<b>Perigos</b>\nTropas vermelhas patrulham as ruas, guardi\xF5es roxos perseguem quem chega perto e as po\xE7as verdes corroem sua vida.\n\n<b>Controles</b>\nMover: WASD / setas / anal\xF3gico\nDash: Espa\xE7o / A  (gasta stamina e deixa invulner\xE1vel)\nAtacar: J / clique / X"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
